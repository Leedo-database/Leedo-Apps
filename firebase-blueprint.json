{
  "entities": {
    "App": {
      "title": "App",
      "description": "An internal LEEDO dashboard application tile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "url": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "icon": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "url"]
    },
    "Category": {
      "title": "Category",
      "description": "An app category in LEEDO dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 80 },
        "order": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Notice": {
      "title": "Notice",
      "description": "A notice for the employee notice board",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string", "maxLength": 50 },
        "author": { "type": "string", "maxLength": 100 },
        "isImportant": { "type": "boolean" }
      },
      "required": ["id", "title", "content"]
    },
    "Employee": {
      "title": "Employee",
      "description": "LEEDO employee profile with auth credentials",
      "type": "object",
      "properties": {
        "sl": { "type": "number" },
        "eid": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 100 },
        "designation": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "password": { "type": "string", "maxLength": 100 },
        "isPasswordChanged": { "type": "boolean" }
      },
      "required": ["eid", "name", "role"]
    },
    "Settings": {
      "title": "PortalSettings",
      "description": "LEEDO portal configuration for background and logo",
      "type": "object",
      "properties": {
        "backgroundConfig": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["pattern", "image"] },
            "imageUrl": { "type": "string", "maxLength": 2000 },
            "blur": { "type": "number" },
            "dim": { "type": "number" },
            "overlayColor": { "type": "string", "maxLength": 30 }
          }
        },
        "customLogo": { "type": "string" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      }
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Connection test doc",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": { "$ref": "App" },
      "description": "Collection of apps available on the dashboard"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "Category" },
      "description": "Collection of app categories"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "Notice" },
      "description": "Collection of notice board items"
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "Employee" },
      "description": "Collection of LEEDO employees"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "Settings" },
      "description": "Portal visual settings (background, logo)"
    },
    "/test/{testId}": {
      "schema": { "$ref": "ConnectionTest" },
      "description": "Firestore connection validation"
    }
  }
}
