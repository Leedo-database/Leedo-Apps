rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidApp(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.url is string && data.url.size() > 0 && data.url.size() <= 1000 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 50)) &&
             (!('order' in data) || data.order is number) &&
             (!('isCustom' in data) || data.isCustom is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
             (!('order' in data) || data.order is number);
    }

    function isValidNotice(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('author' in data) || (data.author is string && data.author.size() <= 100)) &&
             (!('isImportant' in data) || data.isImportant is bool);
    }

    function isValidEmployee(data) {
      return data.eid is string && data.eid.size() > 0 && data.eid.size() <= 20 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (data.role == 'admin' || data.role == 'staff') &&
             (!('sl' in data) || data.sl is number) &&
             (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 50)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 100)) &&
             (!('isPasswordChanged' in data) || data.isPasswordChanged is bool);
    }

    // Apps collection
    match /apps/{appId} {
      allow read: if true;
      allow create: if isValidId(appId) && isValidApp(request.resource.data);
      allow update: if isValidId(appId) && isValidApp(request.resource.data);
      allow delete: if isValidId(appId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isValidCategory(request.resource.data);
      allow update: if isValidId(categoryId) && isValidCategory(request.resource.data);
      allow delete: if isValidId(categoryId);
    }

    // Notices collection
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isValidId(noticeId) && isValidNotice(request.resource.data);
      allow update: if isValidId(noticeId) && isValidNotice(request.resource.data);
      allow delete: if isValidId(noticeId);
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if true;
      allow create: if isValidId(employeeId) && isValidEmployee(request.resource.data);
      allow update: if isValidId(employeeId) && isValidEmployee(request.resource.data);
      allow delete: if isValidId(employeeId);
    }

    // Portal Settings (Background config, custom logo)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
